# Skopiuj: cp deploy.conf.example deploy.conf  (deploy.conf jest w .gitignore)
# Edytuj deploy.conf — bash source, bez export też działa.
#
# Po git pull, gdy zmienia się przykład: zmerguj nowe klucze do deploy.conf (diff z example).
# Żeby nie ustawiać od nowa kluczy OVH / SMTP / haseł: trzymaj je w deploy.local.conf
# (tworzysz raz, plik w .gitignore — źródłowany po deploy.conf, nadpisuje zmienne).
# Np. echo 'OVH_APPLICATION_KEY="xxx"' >> deploy.local.conf

# --- 1. Proxmox (qm: storage, most, VLAN) ---
STORAGE="Storage"
BRIDGE="vmbr0"
VLAN="79"

# --- 2. Sieć gościa (cloud-init ipconfig0) ---
IP_FILE="used_ips.txt"
IP_PREFIX="213.210.35"
MASK="/25"
GW="213.210.35.2"

# --- 3. Obraz i konto w gościu ---
USER="debian"
SSHKEY="$HOME/yszty-h.pub"
# Bez klucza SSH w cloud-init: SKIP_SSHKEY="true" lub ./deploy-vm.sh -K. Gdy ustawisz hasło gościa (VM_USER_PASSWORD / -W / -w), klucz i tak nie jest dodawany.
# SKIP_SSHKEY="false"
IMAGE="/mnt/temp_drive/import/debian-13-generic-amd64.qcow2"
# Opcjonalne hasło dla USER w gościu (cloud-init); puste = logowanie kluczem SSH (SSHKEY).
# Unikaj hasła w jednej linii poleceń (historia/ps). Lepiej: ./deploy-vm.sh -W (ciche pytanie)
# albo hasło w tym pliku / deploy.local.conf, albo: ./deploy-vm.sh -w - < plik_z_haslem (chmod 600)
# VM_USER_PASSWORD=""

# --- 4. Cloud-init vendor (qm --cicustom vendor=…; logika w deploy-vm.sh: deploy_cloudinit_*) ---
# Profil → plik <profil>.yml w katalogu Snippets (storage: CLOUDINIT_CUSTOM_SNIPPET_STORAGE).
# Tryb auto (puste CLOUDINIT_DEPLOY_PROFILE): hasło gościa ustawione → password-login-allowed; brak hasła → password-login-not-allowed
# Nadpisanie profilu: CLOUDINIT_DEPLOY_PROFILE lub ./deploy-vm.sh -P profil (CLI_DEPLOY_PROFILE)
# Lista profili + utworzenie brakujących szablonów .yml: ./deploy-vm.sh -C
# CLOUDINIT_DEPLOY_PROFILE=""
# CLOUDINIT_CUSTOM_SNIPPET_STORAGE="local"
# CLOUDINIT_CUSTOM_SNIPPETS_PATH="/var/lib/vz/snippets"
# Kilka ścieżek rozdziel „:” (pierwsza istniejąca). Aliasy legacy: CLOUDINIT_SNIPPET_STORAGE, CLOUDINIT_SNIPPETS_PATH
# Opcjonalna stała nazwa pliku zamiast <profil>.yml: CLOUDINIT_VENDOR_FILE_OVERRIDE (legacy: CLOUDINIT_VENDOR_SSH_PWAUTH_FILE)
# Treść YAML przy deployu: funkcja deploy_cloudinit_vendor_yaml_for_profile; szablony z -C: deploy_cloudinit_vendor_yaml_bootstrap_template

# --- 5. OVH DNS (API) ---
OVH_APPLICATION_KEY=""
OVH_APPLICATION_SECRET=""
OVH_CONSUMER_KEY=""
OVH_ENDPOINT="https://eu.api.ovh.com"
OVH_DNS_TTL="3600"

# Po każdym rekordzie A: www.<ten_sam_host> -> CNAME (np. www.server123.hostier.pl -> server123.hostier.pl). Wyłączenie: OVH_DNS_WWW_CNAME="false"
# OVH_DNS_WWW_CNAME="true"

# Pierwszy rekord A — ten sam host co nazwa VM: <VM_NAME_PREFIX><VMID>.<strefa>
# Np. server1847392.hostier.pl
OVH_DNS_AUTO_ZONE="hostier.pl"

# Drugi rekord (opcjonalny) — ten sam IP; puste = tylko rekord auto powyżej
OVH_DNS_FQDN=""

# Albo kilka dodatkowych FQDN (zamiast pojedynczego OVH_DNS_FQDN):
# OVH_DNS_FQDNS=( "vm1.hostier.pl" "backup.inna-domena.pl" )

# Opcjonalnie: stałe VMID / IP (nadpisują -i / -p). Bez tego: losowy VMID 1###### (1 + 6 cyfr).
# DEPLOY_VMID=""
# DEPLOY_IP=""

# --- 6. Powiadomienie e-mail (SMTP po wdrożeniu; opcjonalne) ---
# Bez MAIL_SMTP_HOST skrypt nie wysyła maili. Wymaga curl na hoście Proxmox.
# MAIL_SMTP_HOST="smtp.example.com"
# MAIL_SMTP_PORT="587"
# MAIL_SMTP_USER=""
# MAIL_SMTP_PASSWORD=""
# Nadawca: ustaw MAIL_FROM lub zostaw puste — użyte zostanie MAIL_SMTP_USER (ważne przy OVH: zgodność z kontem).
# MAIL_FROM="noreply@example.com"
# MAIL_ADMIN="admin@example.com"
# Opcjonalnie: temat z prefiksem (domyślnie [deploy-vm])
# MAIL_SUBJECT_PREFIX="[deploy-vm]"
# Port 465 = smtps (SSL). Przy OVH (ssl0.ovh.net) zwykle 465 albo 587 + poniżej:
# MAIL_SMTP_PORT="465"
# Jeśli curl zwraca (67) Login denied na 587, ustaw MAIL_SMTP_AUTH="login" albo przejdź na port 465.
# MAIL_SMTP_AUTH="login"
# Diagnostyka (log SMTP na stderr): MAIL_SMTP_DEBUG="true"
# MAIL_SMTP_DEBUG="false"
# STARTTLS na 587 domyślnie włączony; wyłączenie lokalnego relay bez TLS:
# MAIL_SMTP_STARTTLS="false"
# Certyfikat niezaufany (np. self-signed):
# MAIL_SMTP_INSECURE="true"
# Hasło z ":" w środku psuje -u w curl — zmień hasło albo użyj innej metody wysyłki.
# Dodatkowy odbiorca: ./deploy-vm.sh -e inny@example.com (poza MAIL_ADMIN)

# --- 7. Rozmiary VM i nazwa (domyślne, gdy nie podasz -d / -r; nazwa: prefix+VMID) ---
DISK_GB_DEFAULT="40"
RAM_GB_DEFAULT="2"
# Nazwa VM domyślnie: VM_NAME_PREFIX + VMID (np. server1847392). Nadpisanie: VM_NAME lub ./deploy-vm.sh -n NAZWA
# VM_NAME_PREFIX="server"
# VM_NAME=""
