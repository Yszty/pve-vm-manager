# BREAKING: nowy zestaw kluczy — skopiuj jako deploy.conf i dostosuj.
# cp deploy.conf.example deploy.conf

# --- 1. Proxmox ---
STORAGE="Storage"
BRIDGE="vmbr0"
VLAN="79"

# --- 2. Sieć gościa ---
IP_FILE="used_ips.txt"
IP_PREFIX="213.210.35"
MASK="/25"
GW="213.210.35.2"

# --- 3. Obraz i konto w gościu ---
GUEST_USERNAME="debian"
SSH_PUBLIC_KEY_FILE="$HOME/yszty-h.pub"
# false = nie wstrzykuj klucza z pliku (jak stary SKIP_SSHKEY=true); przy haśle klucz domyślnie i tak pomijany — chyba że -k
CI_SSH_PUBLIC_KEY_ENABLED="true"
IMAGE="/mnt/temp_drive/import/debian-13-generic-amd64.qcow2"
# Opcjonalnie: opis systemu gościa w podsumowaniu i mailu. Puste = z nazwy pliku IMAGE (tu: Debian 13).
# GUEST_OS_LABEL="Debian 13"
# Opcjonalne hasło gościa; bezpieczniej: deploy-vm.sh -W / -w -
# GUEST_PASSWORD=""

# --- 4. Cloud-init vendor (cicustom) ---
# Profil: puste → auto (hasło → password-login-allowed + chpasswd+expire w vendor)
# CI_VENDOR_PROFILE=""
CI_SNIPPETS_STORAGE="local"
CI_SNIPPETS_PATH="/var/lib/vz/snippets"
# CI_VENDOR_FILENAME_OVERRIDE=""

# --- 5. OVH DNS ---
OVH_APPLICATION_KEY=""
OVH_APPLICATION_SECRET=""
OVH_CONSUMER_KEY=""
OVH_ENDPOINT="https://eu.api.ovh.com"
OVH_DNS_TTL="3600"
# OVH_DNS_WWW_CNAME="true"
OVH_DNS_AUTO_ZONE="hostier.pl"
OVH_DNS_FQDN=""
# OVH_DNS_FQDNS=( "vm1.example.pl" )

# --- 6. SMTP ---
# MAIL_SMTP_HOST="smtp.example.com"
# MAIL_SMTP_PORT="587"
# MAIL_SMTP_USER=""
# MAIL_SMTP_PASSWORD=""
# MAIL_FROM=""
# MAIL_ADMIN=""
# MAIL_SUBJECT_PREFIX="[deploy-vm]"
# MAIL_SMTP_AUTH="login"
# MAIL_SMTP_DEBUG="false"
# MAIL_SMTP_STARTTLS="true"
# MAIL_SMTP_INSECURE="false"

# --- 7. Rozmiary i nazwa VM (GiB = gibibajty, 1024; jak qm resize …G i pamięć VM) ---
DISK_GIB_DEFAULT="40"
RAM_GIB_DEFAULT="2"
VM_NAME_PREFIX="server"
# Opcjonalna nazwa zamiast VM_NAME_PREFIX+VMID:
# VM_CUSTOM_NAME=""
# DEPLOY_VMID=""
# DEPLOY_IP=""
