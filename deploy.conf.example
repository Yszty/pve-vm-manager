# Skopiuj: cp deploy.conf.example deploy.conf  (deploy.conf jest w .gitignore)
# Edytuj deploy.conf — bash source, bez export też działa.

# --- Proxmox ---
STORAGE="Storage"
BRIDGE="vmbr0"
VLAN="79"

# --- Sieć gościa (cloud-init) ---
IP_FILE="used_ips.txt"
IP_PREFIX="213.210.35"
MASK="/25"
GW="213.210.35.2"

# --- Obraz / użytkownik ---
USER="debian"
SSHKEY="$HOME/yszty-h.pub"
IMAGE="/mnt/temp_drive/import/debian-13-generic-amd64.qcow2"

# Domyślne rozmiary (gdy nie podasz -d / -r)
DISK_GB_DEFAULT="40"
RAM_GB_DEFAULT="2"

# --- OVH DNS (API) ---
OVH_APPLICATION_KEY=""
OVH_APPLICATION_SECRET=""
OVH_CONSUMER_KEY=""
OVH_ENDPOINT="https://eu.api.ovh.com"
OVH_DNS_TTL="3600"
OVH_ZONE="hostier.pl"

# Opcjonalnie: subdomena (puste = apex @). Nadpisuje -s.
# OVH_DNS_SUBDOMAIN=""

# Opcjonalnie: stałe VMID / IP (nadpisują -i / -p)
# DEPLOY_VMID=""
# DEPLOY_IP=""
